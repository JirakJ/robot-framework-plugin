<templateSet group="Robot Framework">
  <template name="test" value="*** Test Cases ***&#10;$TEST_NAME$&#10;    $KEYWORD$    $ARGS$&#10;    $END$" description="New test case" toReformat="true" toShortenFQNames="true">
    <variable name="TEST_NAME" expression="" defaultValue="&quot;Test Name&quot;" alwaysStopAt="true" />
    <variable name="KEYWORD" expression="" defaultValue="&quot;Log&quot;" alwaysStopAt="true" />
    <variable name="ARGS" expression="" defaultValue="&quot;Test step&quot;" alwaysStopAt="true" />
    <variable name="END" expression="" defaultValue="" alwaysStopAt="true" />
    <context>
      <option name="OTHER" value="true" />
    </context>
  </template>

  <template name="keyword" value="*** Keywords ***&#10;$KEYWORD_NAME$&#10;    [Documentation]    $DOC$&#10;    [Arguments]    $ARGS$&#10;    $STEP$&#10;    $END$" description="New keyword" toReformat="true" toShortenFQNames="true">
    <variable name="KEYWORD_NAME" expression="" defaultValue="&quot;Keyword Name&quot;" alwaysStopAt="true" />
    <variable name="DOC" expression="" defaultValue="&quot;Keyword description&quot;" alwaysStopAt="true" />
    <variable name="ARGS" expression="" defaultValue="&quot;\${arg}&quot;" alwaysStopAt="true" />
    <variable name="STEP" expression="" defaultValue="&quot;Log    \${arg}&quot;" alwaysStopAt="true" />
    <variable name="END" expression="" defaultValue="" alwaysStopAt="true" />
    <context>
      <option name="OTHER" value="true" />
    </context>
  </template>

  <template name="for" value="FOR    \${item}    IN    @{$LIST$}&#10;    $STEP$&#10;END" description="FOR loop" toReformat="true" toShortenFQNames="true">
    <variable name="LIST" expression="" defaultValue="&quot;items&quot;" alwaysStopAt="true" />
    <variable name="STEP" expression="" defaultValue="&quot;Log    \${item}&quot;" alwaysStopAt="true" />
    <context>
      <option name="OTHER" value="true" />
    </context>
  </template>

  <template name="if" value="IF    $CONDITION$&#10;    $STEP$&#10;END" description="IF block" toReformat="true" toShortenFQNames="true">
    <variable name="CONDITION" expression="" defaultValue="&quot;\${variable} == 'value'&quot;" alwaysStopAt="true" />
    <variable name="STEP" expression="" defaultValue="&quot;Log    Condition true&quot;" alwaysStopAt="true" />
    <context>
      <option name="OTHER" value="true" />
    </context>
  </template>

  <template name="try" value="TRY&#10;    $STEP$&#10;EXCEPT&#10;    Log    Error occurred&#10;END" description="TRY-EXCEPT block" toReformat="true" toShortenFQNames="true">
    <variable name="STEP" expression="" defaultValue="&quot;Log    Trying operation&quot;" alwaysStopAt="true" />
    <context>
      <option name="OTHER" value="true" />
    </context>
  </template>

  <template name="group" value="GROUP    $NAME$&#10;    $STEP$&#10;END" description="GROUP block (Robot Framework 7.2+)" toReformat="true" toShortenFQNames="true">
    <variable name="NAME" expression="" defaultValue="&quot;Group name&quot;" alwaysStopAt="true" />
    <variable name="STEP" expression="" defaultValue="&quot;Log    Grouped step&quot;" alwaysStopAt="true" />
    <context>
      <option name="OTHER" value="true" />
    </context>
  </template>

  <template name="var" value="VAR    \${$NAME$}    $VALUE$    scope=$SCOPE$" description="VAR statement (Robot Framework 7.0+)" toReformat="true" toShortenFQNames="true">
    <variable name="NAME" expression="" defaultValue="&quot;name&quot;" alwaysStopAt="true" />
    <variable name="VALUE" expression="" defaultValue="&quot;value&quot;" alwaysStopAt="true" />
    <variable name="SCOPE" expression="enum(&quot;LOCAL&quot;,&quot;TEST&quot;,&quot;TASK&quot;,&quot;SUITE&quot;,&quot;SUITES&quot;,&quot;GLOBAL&quot;)" defaultValue="&quot;TEST&quot;" alwaysStopAt="true" />
    <context>
      <option name="OTHER" value="true" />
    </context>
  </template>

  <template name="while" value="WHILE    $CONDITION$    limit=$LIMIT$&#10;    $STEP$&#10;END" description="WHILE loop with limit" toReformat="true" toShortenFQNames="true">
    <variable name="CONDITION" expression="" defaultValue="&quot;\${counter} &lt; 10&quot;" alwaysStopAt="true" />
    <variable name="LIMIT" expression="" defaultValue="&quot;10x&quot;" alwaysStopAt="true" />
    <variable name="STEP" expression="" defaultValue="&quot;Log    Looping&quot;" alwaysStopAt="true" />
    <context>
      <option name="OTHER" value="true" />
    </context>
  </template>

  <template name="typedvar" value="\${$NAME$: $TYPE$}    $VALUE$" description="Typed variable (Robot Framework 7.3+)" toReformat="false" toShortenFQNames="true">
    <variable name="NAME" expression="" defaultValue="&quot;NAME&quot;" alwaysStopAt="true" />
    <variable name="TYPE" expression="enum(&quot;int&quot;,&quot;float&quot;,&quot;bool&quot;,&quot;str&quot;,&quot;date&quot;,&quot;datetime&quot;,&quot;list[int]&quot;,&quot;Secret&quot;)" defaultValue="&quot;int&quot;" alwaysStopAt="true" />
    <variable name="VALUE" expression="" defaultValue="&quot;0&quot;" alwaysStopAt="true" />
    <context>
      <option name="OTHER" value="true" />
    </context>
  </template>

  <template name="secret" value="\${$NAME$: Secret}    %{$ENV$}" description="Secret variable (Robot Framework 7.4+)" toReformat="false" toShortenFQNames="true">
    <variable name="NAME" expression="" defaultValue="&quot;PASSWORD&quot;" alwaysStopAt="true" />
    <variable name="ENV" expression="" defaultValue="&quot;APP_PASSWORD&quot;" alwaysStopAt="true" />
    <context>
      <option name="OTHER" value="true" />
    </context>
  </template>
</templateSet>

