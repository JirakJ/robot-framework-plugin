<idea-plugin>
    <id>com.jakubjirak.robotframework</id>
    <name>Robot Framework</name>
    <vendor email="support@jakubjirak.com" url="https://jakubjirak.com">Jakub Jirak</vendor>

    <description><![CDATA[<h2>Robot Framework — Full IDE Intelligence for Robot Framework</h2>

<p>
  Turn your JetBrains IDE into a complete Robot Framework development environment.
  Intelligent code completion, step-through debugging, interactive REPL, and built-in
  web inspector — everything you need to write, run, and debug Robot Framework tests.
</p>

<h3>Editing and Navigation</h3>
<ul>
  <li><b>Syntax Highlighting</b> — Full support for Robot Framework 7+ keywords, variables, and sections</li>
  <li><b>Code Completion</b> — Context-aware suggestions for keywords, variables, and library imports</li>
  <li><b>Go-To Declaration</b> — Jump to keyword definitions and find references across files</li>
  <li><b>Rename Refactoring</b> — Safely rename keywords across all project files</li>
  <li><b>Structure View</b> — Browse test cases, keywords, and variables in a tree view</li>
  <li><b>Code Folding</b> — Collapse sections, test cases, and keywords</li>
</ul>

<h3>Code Quality</h3>
<ul>
  <li><b>Code Formatter</b> — One-shot reformat (Ctrl+Alt+Shift+R) that normalizes section headers, expands tabs to spaces, trims trailing whitespace, and tidies blank lines</li>
  <li><b>Inspections</b> — Detect long test names, empty test cases, undefined keywords, missing resources, duplicate test-case names, tab separators, trailing whitespace, leftover TODO/FIXME markers, and unused suite variables</li>
  <li><b>Quick Fixes</b> — Convert tabs to spaces and strip trailing whitespace with a single keystroke</li>
  <li><b>Error Annotations</b> — Syntax errors, undefined variables, and duplicate keywords highlighted inline</li>
  <li><b>Spellchecking</b> — Spell check support for Robot Framework files</li>
  <li><b>Parameter Hints</b> — Inline parameter hints for keyword arguments</li>
</ul>

<h3>Execution and Debugging</h3>
<ul>
  <li><b>Test Execution</b> — Run tests directly from the editor with rich output</li>
  <li><b>Step-Through Debugger</b> — Breakpoints, variable inspection, and conditional breakpoints</li>
  <li><b>Interactive REPL</b> — Test keywords in real time without running full suites</li>
  <li><b>Performance Profiler</b> — Find slow keywords and optimize execution time</li>
</ul>

<h3>Web Testing</h3>
<ul>
  <li><b>Web Inspector</b> — Built-in browser element inspector for locator generation</li>
  <li><b>SeleniumLibrary Support</b> — Full completion and navigation for SeleniumLibrary keywords</li>
</ul>

<h3>Requirements</h3>
<ul>
  <li>IntelliJ IDEA, PyCharm, or compatible JetBrains IDE (2024.1+)</li>
  <li>Python with Robot Framework installed</li>
</ul>

<h3>Support</h3>
<ul>
  <li>Documentation: <a href="https://jakubjirak.com">jakubjirak.com</a></li>
  <li>Issues: <a href="https://github.com/JirakJ/robot-framework-plugin">GitHub</a></li>
  <li>Email: support@jakubjirak.com</li>
</ul>]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>

    <product-descriptor code="PROBOTFRAMEWORK" release-date="20260614" release-version="20264" optional="true"/>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Language Definition -->
        <fileType name="Robot Framework"
                 implementationClass="com.jakubjirak.robotframework.language.RobotFileType"
                 fieldName="INSTANCE"
                 language="RobotFramework"
                 extensions="robot;resource;txt"/>

        <!-- Syntax Highlighter -->
        <lang.syntaxHighlighterFactory language="RobotFramework"
                                      implementationClass="com.jakubjirak.robotframework.language.RobotSyntaxHighlighterFactory"/>

        <!-- Parser Definition -->
        <lang.parserDefinition language="RobotFramework"
                              implementationClass="com.jakubjirak.robotframework.language.RobotParserDefinition"/>
        
        <lang.syntaxHighlighterFactory language="RobotFramework"
                                       implementationClass="com.jakubjirak.robotframework.editor.RobotSyntaxHighlighterFactory"/>
        
        <lang.commenter language="RobotFramework"
                       implementationClass="com.jakubjirak.robotframework.editor.RobotCommenter"/>
        
        <lang.braceMatcher language="RobotFramework"
                          implementationClass="com.jakubjirak.robotframework.editor.RobotBraceMatcher"/>
        
        <!-- Code Completion -->
        <completion.contributor language="RobotFramework"
                               implementationClass="com.jakubjirak.robotframework.editor.RobotCompletionContributor"/>
        
        <!-- Documentation -->
        <lang.documentationProvider language="RobotFramework"
                                   implementationClass="com.jakubjirak.robotframework.editor.RobotDocumentationProvider"/>
        
        <!-- Code Folding -->
        <lang.foldingBuilder language="RobotFramework"
                            implementationClass="com.jakubjirak.robotframework.editor.RobotFoldingBuilder"/>
        
        <!-- Structure View -->
        <lang.psiStructureViewFactory language="RobotFramework"
                                     implementationClass="com.jakubjirak.robotframework.editor.RobotStructureViewFactory"/>

        <!-- Breadcrumbs -->
        <breadcrumbsInfoProvider implementation="com.jakubjirak.robotframework.editor.RobotBreadcrumbsProvider"/>

        <!-- Auto-indent -->
        <lineIndentProvider implementation="com.jakubjirak.robotframework.editor.RobotLineIndentProvider"/>

        <!-- Annotators -->
        <annotator language="RobotFramework"
                   implementationClass="com.jakubjirak.robotframework.editor.RobotEmbeddedArgumentAnnotator"/>
        <annotator language="RobotFramework"
                   implementationClass="com.jakubjirak.robotframework.editor.RobotSyntaxErrorAnnotator"/>
        <annotator language="RobotFramework"
                   implementationClass="com.jakubjirak.robotframework.editor.RobotUndefinedKeywordAnnotator"/>
        <annotator language="RobotFramework"
                   implementationClass="com.jakubjirak.robotframework.editor.RobotDuplicateKeywordAnnotator"/>
        <annotator language="RobotFramework"
                   implementationClass="com.jakubjirak.robotframework.editor.RobotUndefinedVariableAnnotator"/>
        <annotator language="RobotFramework"
                   implementationClass="com.jakubjirak.robotframework.editor.RobotMissingResourceAnnotator"/>

        <!-- Go to Declaration -->
        <gotoDeclarationHandler implementation="com.jakubjirak.robotframework.navigation.RobotGotoDeclarationHandler"/>

        <!-- Code Inspections -->
        <localInspection language="RobotFramework"
                        groupName="Robot Framework"
                        displayName="Test name too long"
                        enabledByDefault="true"
                        level="WARNING"
                        implementationClass="com.jakubjirak.robotframework.inspection.RobotLongTestNameInspection"/>
        <localInspection language="RobotFramework"
                        groupName="Robot Framework"
                        displayName="Empty test case"
                        enabledByDefault="true"
                        level="WARNING"
                        implementationClass="com.jakubjirak.robotframework.inspection.RobotEmptyTestCaseInspection"/>
        <localInspection language="RobotFramework"
                        groupName="Robot Framework"
                        displayName="Tab character used for separation"
                        enabledByDefault="true"
                        level="WARNING"
                        implementationClass="com.jakubjirak.robotframework.inspection.RobotTabCharacterInspection"/>
        <localInspection language="RobotFramework"
                        groupName="Robot Framework"
                        displayName="Trailing whitespace"
                        enabledByDefault="true"
                        level="WEAK WARNING"
                        implementationClass="com.jakubjirak.robotframework.inspection.RobotTrailingWhitespaceInspection"/>
        <localInspection language="RobotFramework"
                        groupName="Robot Framework"
                        displayName="Duplicate test case name"
                        enabledByDefault="true"
                        level="ERROR"
                        implementationClass="com.jakubjirak.robotframework.inspection.RobotDuplicateTestNameInspection"/>
        <localInspection language="RobotFramework"
                        groupName="Robot Framework"
                        displayName="Unresolved TODO/FIXME marker"
                        enabledByDefault="true"
                        level="WEAK WARNING"
                        implementationClass="com.jakubjirak.robotframework.inspection.RobotTodoCommentInspection"/>
        <localInspection language="RobotFramework"
                        groupName="Robot Framework"
                        displayName="Unused suite variable"
                        enabledByDefault="false"
                        level="WARNING"
                        implementationClass="com.jakubjirak.robotframework.inspection.RobotUnusedVariableInspection"/>

        <!-- Live Templates -->
        <defaultLiveTemplates file="/liveTemplates/RobotFramework.xml"/>

        <!-- Documentation Provider -->
        <lang.documentationProvider language="RobotFramework"
                                   implementationClass="com.jakubjirak.robotframework.editor.RobotDocumentationProvider"/>

        <!-- Rename Refactoring -->
        <renameHandler implementation="com.intellij.refactoring.rename.PsiElementRenameHandler" order="first"/>
        <renamePsiElementProcessor implementation="com.jakubjirak.robotframework.refactoring.RobotKeywordRenameProcessor"/>

        <!-- Icon Provider -->
        <iconProvider implementation="com.jakubjirak.robotframework.editor.RobotIconProvider"/>

        <!-- Color Settings -->
        <colorSettingsPage implementation="com.jakubjirak.robotframework.settings.RobotColorSettingsPage"/>

        <!-- Parameter Hints (declarative API) -->
        <codeInsight.inlayHintsProvider language="RobotFramework"
                                        providerId="robot.parameter.hints"
                                        isEnabledByDefault="true"
                                        group="PARAMETERS_GROUP"
                                        description="Shows parameter names for Robot Framework keyword arguments"
                                        implementationClass="com.jakubjirak.robotframework.editor.RobotParameterHintsProvider"/>

        <!-- Spellchecking -->
        <spellchecker.support language="RobotFramework"
                             implementationClass="com.jakubjirak.robotframework.editor.RobotSpellcheckingStrategy"/>

        <!-- Find Usages -->
        <lang.findUsagesProvider language="RobotFramework"
                                implementationClass="com.jakubjirak.robotframework.editor.RobotFindUsagesProvider"/>
        
        <!-- Reference -->
        <psi.referenceContributor language="RobotFramework"
                                 implementation="com.jakubjirak.robotframework.language.RobotReferenceContributor"/>
        
        <!-- Test Execution -->
        <configurationType implementation="com.jakubjirak.robotframework.execution.RobotRunConfigurationType"/>
        <programRunner implementation="com.jakubjirak.robotframework.execution.RobotProgramRunner"/>
        
        <!-- Tool Windows -->
        <toolWindow id="Robot Framework"
                   anchor="bottom"
                   icon="/icons/robot_13x13.svg"
                   factoryClass="com.jakubjirak.robotframework.ui.RobotToolWindowFactory"/>
        
        <toolWindow id="Web Inspector"
                   anchor="right"
                   icon="/icons/inspector_13x13.svg"
                   factoryClass="com.jakubjirak.robotframework.ui.WebInspectorToolWindowFactory"/>
        
        <!-- Project Service -->
        <projectService serviceImplementation="com.jakubjirak.robotframework.core.RobotProjectService"/>
    
        <projectService serviceImplementation="com.jakubjirak.robotframework.settings.RobotSettings"/>

        <projectConfigurable
            parentId="tools"
            instance="com.jakubjirak.robotframework.settings.RobotSettingsConfigurable"
            id="robot.framework.settings"
            displayName="Robot Framework"/>

        <notificationGroup id="Robot Framework Feedback" displayType="BALLOON"/>
        <projectActivity implementation="com.jakubjirak.robotframework.feedback.FeedbackNotifier"/>
    </extensions>

    <actions>
        <group id="RobotFramework.Menu" text="Robot Framework" description="Robot Framework actions">
            <add-to-group group-id="MainMenu" anchor="before" relative-to-action="HelpMenu"/>
            
            <action id="RobotFramework.RunTest"
                    class="com.jakubjirak.robotframework.execution.actions.RunTestAction"
                    text="Run Test"
                    description="Run Robot Framework test"
                    icon="AllIcons.Actions.Execute">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift F10"/>
            </action>
            
            <action id="RobotFramework.DebugTest"
                    class="com.jakubjirak.robotframework.execution.actions.DebugTestAction"
                    text="Debug Test"
                    description="Debug Robot Framework test"
                    icon="AllIcons.Actions.StartDebugger">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift F9"/>
            </action>
            
            <separator/>
            
            <action id="RobotFramework.OpenREPL"
                    class="com.jakubjirak.robotframework.ui.actions.OpenReplAction"
                    text="Open Interactive REPL"
                    description="Open Robot Framework interactive console"
                    icon="AllIcons.Nodes.Console"/>
            
            <action id="RobotFramework.OpenWebInspector"
                    class="com.jakubjirak.robotframework.ui.actions.OpenWebInspectorAction"
                    text="Open Web Inspector"
                    description="Open Web Inspector for locator generation"
                    icon="AllIcons.General.InspectionsEye"/>

            <separator/>

            <action id="RobotFramework.FormatFile"
                    class="com.jakubjirak.robotframework.editor.actions.FormatRobotFileAction"
                    text="Format Robot File"
                    description="Reformat the current Robot Framework file"
                    icon="AllIcons.Actions.Refactor">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift R"/>
            </action>

            <separator/>
            
            <action id="RobotFramework.Settings"
                    class="com.jakubjirak.robotframework.ui.actions.SettingsAction"
                    text="Settings"
                    description="Configure Robot Framework plugin"
                    icon="AllIcons.General.Settings"/>
        </group>

        <!-- Editor context menu -->
        <group id="RobotFramework.EditorContextMenu">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <action id="RobotFramework.GenerateKeyword"
                    class="com.jakubjirak.robotframework.editor.actions.GenerateKeywordAction"
                    text="Generate Keyword"
                    description="Generate new Robot Framework keyword"
                    icon="AllIcons.Actions.IntentionBulb"/>
            <action id="RobotFramework.FormatFileContext"
                    class="com.jakubjirak.robotframework.editor.actions.FormatRobotFileAction"
                    text="Format Robot File"
                    description="Reformat the current Robot Framework file"
                    icon="AllIcons.Actions.Refactor"/>
        </group>
    </actions>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="com.jakubjirak.robotframework.core.RobotProjectListener"/>
    </extensions>

    <change-notes><![CDATA[
        <h3>2026.4.0 — Code Quality &amp; Formatting</h3>
        <ul>
            <li><b>Robot file formatter</b> — Reformat a suite with Ctrl+Alt+Shift+R: canonical section headers, tabs → spaces, trimmed trailing whitespace, and normalized blank lines (idempotent)</li>
            <li><b>New inspections</b> — Duplicate test-case name, tab separator, trailing whitespace, unresolved TODO/FIXME markers, and unused suite variables</li>
            <li><b>Quick fixes</b> — Convert tabs to spaces and remove trailing whitespace</li>
            <li><b>Formatter settings</b> — Configure indent size and header normalization under Settings → Tools → Robot Framework</li>
        </ul>

        <h3>2026.3.6 — Freemium Model</h3>
        <ul>
            <li><b>Freemium licensing</b> — Added product-descriptor for JetBrains Marketplace freemium model (code: PROBOTFRAMEWORK)</li>
        </ul>

        <h3>What's New</h3>
        <ul>
            <li><b>Intelligent Code Completion</b> - Context-aware suggestions for keywords, variables, and library imports</li>
            <li><b>Go-To Navigation</b> - Jump to keyword definitions, find references, and view project structure</li>
            <li><b>Step-Through Debugger</b> - Debug Robot Framework tests with breakpoints, variable inspection, and conditional breakpoints</li>
            <li><b>Interactive REPL</b> - Test keywords in real time without running full test suites</li>
            <li><b>Web Inspector</b> - Built-in browser element inspector for Selenium-based test locator generation</li>
            <li><b>Syntax Highlighting</b> - Full syntax highlighting for Robot Framework 7+ keywords, variables, and sections</li>
            <li><b>Rename Refactoring</b> - Safely rename keywords across all files with normalized matching</li>
            <li><b>Code Inspections</b> - Detect issues like long test names, empty test cases, and undefined keywords</li>
            <li><b>Performance Profiler</b> - Profile test execution to find slow keywords and optimize test suites</li>
            <li><b>Live Templates</b> - Quick insertion of common Robot Framework patterns and structures</li>
        </ul>
    ]]></change-notes>
</idea-plugin>
